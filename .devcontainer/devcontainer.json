{
  "name": "Retail Revenue Intelligence",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "pip install --user -r requirements.txt && python scripts/doctor.py || true",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Retail dashboard", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "qwtel.sqlite-viewer"]
    }
  }
}
